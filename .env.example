# ==============================================================================
# QuantAI — Enterprise Quantitative Intelligence Workstation Environment Configuration
# Author: yuva.devlab@gmail.com
# ==============================================================================

# Runtime Environment (development | production | test | staging)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Ports & Gateway Network Routing
# ------------------------------------------------------------------------------
PORT=4005
WS_PORT=4006
WEB_PORT=3005
QUANT_ENGINE_PORT=8000
CORS_ORIGIN=http://localhost:3005

# Frontend Client Public Endpoints
VITE_API_URL=http://localhost:4005/api
VITE_WS_URL=ws://localhost:4006

# ------------------------------------------------------------------------------
# 2. Database Persistence Layer (PostgreSQL 16 + TimescaleDB)
# ------------------------------------------------------------------------------
DATABASE_DRIVER=postgresql
DATABASE_URL=postgresql://quantai:quantai_secret@localhost:5432/quantai_db
POSTGRES_USER=quantai
POSTGRES_PASSWORD=quantai_secret
POSTGRES_DB=quantai_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. Cache & Low-Latency State (Redis 7.2)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. Event Streaming & Market Tick Bus (Redpanda / Kafka)
# ------------------------------------------------------------------------------
EVENT_BROKER=memory
KAFKA_BROKERS=localhost:19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_SCHEMA_REGISTRY_PORT=8081

# ------------------------------------------------------------------------------
# 5. Quantitative Python Analytics Engine
# ------------------------------------------------------------------------------
QUANT_ENGINE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. Multi-Agent Reasoning & AI Gateway
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_GATEWAY_URL=
JWT_SECRET=quantai-dev-jwt-secret-min32characters-change-in-prod

# ------------------------------------------------------------------------------
# 7. Indian Market Exchange & Broker Integrations (NSE / BSE / Brokers)
# ------------------------------------------------------------------------------
# Zerodha Kite Connect
KITE_API_KEY=
KITE_API_SECRET=

# Angel One SmartAPI
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=
ANGEL_TOTP_KEY=

# Upstox API
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4005/api/auth/callback/upstox
