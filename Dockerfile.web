# syntax=docker/dockerfile:1
# ==============================================================================
# QuantAI Web Workstation — Production Dockerfile
# Optimized for Google Cloud Run, Render, Vercel, and Enterprise OCI Runtimes
# ==============================================================================

FROM node:24-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

# ─── Stage 1: Dependencies ───────────────────────────────────────────────────
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

COPY packages/contracts/package.json ./packages/contracts/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# ─── Stage 2: Builder ─────────────────────────────────────────────────────────
FROM base AS builder
RUN apk add --no-cache libc6-compat
WORKDIR /app

COPY --from=deps /app ./
COPY packages ./packages
COPY apps/web ./apps/web

# Build shared types, events, and workstation web app
RUN pnpm --filter @quant-ai/shared-types build
RUN pnpm --filter @quant-ai/events build
RUN pnpm --filter @quant-ai/web build

# ─── Stage 3: Runner ──────────────────────────────────────────────────────────
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3005
ENV HOSTNAME="0.0.0.0"

# Create non-root system user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 webuser

# Copy built workspace output
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/apps/web ./apps/web

RUN chown -R webuser:nodejs /app

USER webuser
WORKDIR /app/apps/web

EXPOSE 3005

CMD ["pnpm", "preview", "--port", "3005", "--host"]
