// ==============================================================================
// QuantAI — Prisma ORM Database Schema
// Author: yuva.devlab@gmail.com
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// DevLab centralized user account shadow record.
/// Authenticated via DevLab Portal OIDC/JWKS (RS256).
/// Local signup is prohibited; accounts are provisioned Just-In-Time (JIT) on first SSO login.
model User {
  id              String           @id
  email           String           @unique
  name            String
  passwordHash    String?          @map("password_hash")
  avatarUrl       String?          @map("avatar_url")
  preferences     Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  chatSessions    ChatSession[]
  paperPositions  PaperPosition[]
  paperExecutions PaperExecution[]

  @@map("users")
}

/// User Copilot Chat Sessions.
model ChatSession {
  id        String        @id @default(cuid())
  userId    String        @map("user_id")
  title     String        @default("Market Copilot Session")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

/// Messages within a user Copilot Chat Session.
model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String      @map("session_id")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String      @db.Text
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("chat_messages")
}

/// Indian benchmark market indices (NIFTY 50, BANK NIFTY, sectoral tiers).
/// Master metadata only — live prices (CMP, Day High/Low, change %, volume) are streamed into memory/Redis.
model BenchmarkIndex {
  id            String   @id @default(cuid())
  symbol        String   @unique
  name          String
  category      String
  exchange      String   @default("NSE")
  currentPrice  Float?
  change        Float?
  percentChange Float?
  dayHigh       Float?
  dayLow        Float?
  sparkline     Float[]  @default([])
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([category])
  @@map("benchmark_indices")
}

/// Quantitative prediction forecast records and life-cycle state.
model Prediction {
  id             String            @id
  ticker         String
  name           String
  direction      String
  status         String
  entry          Float
  target         Float
  stopLoss       Float
  currentPrice   Float
  confidence     Float
  riskReward     Float
  strategy       String            @default("SWING")
  assetClass     String            @default("EQUITY") @map("asset_class")
  timeHorizon    String
  regime         String
  summary        String
  verdicts       AgentVerdict[]
  trajectory     TrajectoryPoint[]
  researchRuns   ResearchRun[]
  dataSource     String?           @map("data_source")
  dataStatus     String            @default("UNAVAILABLE") @map("data_status")
  observedAt     DateTime?         @map("observed_at")
  metricEligible Boolean           @default(false) @map("metric_eligible")
  outcomePrice   Float?            @map("outcome_price")
  outcomeAt      DateTime?         @map("outcome_at")
  createdAt      DateTime          @default(now())
  expiresAt      DateTime

  @@index([ticker, status])
  @@index([metricEligible, status])
  @@map("predictions")
}

/// Append-only record of each requested analysis, including runs with no prediction.
model ResearchRun {
  id             String      @id @default(cuid())
  ticker         String
  serviceMode    String      @map("service_mode")
  timeHorizon    String      @map("time_horizon")
  result         String      @default("NO_SETUP")
  dataSource     String?     @map("data_source")
  dataStatus     String      @default("UNAVAILABLE") @map("data_status")
  observedAt     DateTime?   @map("observed_at")
  referencePrice Float?      @map("reference_price")
  snapshot       Json        @default("{}")
  predictionId   String?     @map("prediction_id")
  prediction     Prediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([ticker, serviceMode, timeHorizon, createdAt(sort: Desc)])
  @@index([result, createdAt(sort: Desc)])
  @@map("research_runs")
}

/// Multi-agent debate transcript speeches and verdicts.
model AgentVerdict {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  agentRole    String
  stance       String
  confidence   Float
  reasoning    String     @db.Text
  createdAt    DateTime   @default(now())

  @@index([predictionId])
  @@map("agent_verdicts")
}

/// Monte Carlo probabilistic trajectory confidence cone points.
model TrajectoryPoint {
  id           String     @id @default(cuid())
  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  step         Int
  expected     Float
  upperP95     Float
  upperP75     Float
  lowerP25     Float
  lowerP05     Float

  @@index([predictionId, step])
  @@map("trajectory_points")
}

/// Real-time microsecond ticks for market instruments.
model MarketTick {
  id        String   @id @default(cuid())
  symbol    String
  price     Float
  volume    Float
  timestamp DateTime @default(now())

  @@index([symbol, timestamp(sort: Desc)])
  @@map("market_ticks")
}

/// Screened universe items metadata.
/// Live metrics (RSI, volume ratio, CMP, change %) are calculated dynamically in real-time.
model ScreenerStock {
  symbol        String   @id
  company       String
  sector        String
  exchange      String   @default("NSE")
  price         Float?
  changePercent Float?
  volumeRatio   Float?
  rsi           Float?
  isBreakout    Boolean  @default(false)
  isSurge       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@index([isBreakout, isSurge])
  @@map("screener_stocks")
}

/// Registered AI model providers (Google Gemini, Anthropic, Ollama, OpenAI, Groq, etc.).
model LlmProvider {
  id           String     @id @default(cuid())
  name         String     @db.VarChar(120)
  slug         String     @unique @db.VarChar(64)
  providerType String     @map("provider_type") @db.VarChar(64)
  description  String?    @db.VarChar(500)
  baseUrl      String?    @map("base_url") @db.VarChar(512)
  config       Json       @default("{}")
  isEnabled    Boolean    @default(true) @map("is_enabled")
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String?    @map("created_by") @db.VarChar(128)
  models       LlmModel[]

  @@map("llm_providers")
}

/// Dynamic registered LLM models offered by providers.
model LlmModel {
  id              String      @id @default(cuid())
  providerId      String      @map("provider_id")
  name            String      @db.VarChar(120)
  modelIdentifier String      @map("model_identifier") @db.VarChar(120)
  description     String?     @db.VarChar(500)
  capabilities    Json        @default("{}")
  defaultConfig   Json        @default("{}") @map("default_config")
  contextWindow   Int         @default(8192) @map("context_window")
  isDefault       Boolean     @default(false) @map("is_default")
  isEnabled       Boolean     @default(true) @map("is_enabled")
  isDeprecated    Boolean     @default(false) @map("is_deprecated")
  deprecatedAt    DateTime?   @map("deprecated_at")
  deprecationNote String?     @map("deprecation_note") @db.VarChar(500)
  sortOrder       Int         @default(0) @map("sort_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  createdBy       String?     @map("created_by") @db.VarChar(128)
  provider        LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, modelIdentifier], map: "uq_provider_model_identifier")
  @@index([isEnabled, isDeprecated])
  @@map("llm_models")
}

/// Dynamic system and market configuration parameters.
model SystemConfig {
  key         String   @id @db.VarChar(64)
  value       Json
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_configs")
}

/// Active simulated paper trading positions marked to market.
model PaperPosition {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  symbol      String   @unique
  instrument  String
  side        String   @default("LONG")
  qty         Int
  entryPrice  Float    @map("entry_price")
  stopLoss    Float    @map("stop_loss")
  targetPrice Float    @map("target_price")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("paper_positions")
}

/// Simulated trade executions and historical performance ledger.
model PaperExecution {
  id         String   @id
  userId     String?  @map("user_id")
  symbol     String
  type       String   @default("BUY")
  qty        Int
  entryPrice Float    @map("entry_price")
  exitPrice  Float    @map("exit_price")
  pnl        Float
  outcome    String
  timestamp  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([symbol, timestamp(sort: Desc)])
  @@map("paper_executions")
}
