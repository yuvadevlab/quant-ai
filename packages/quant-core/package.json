{
  "name": "@quant-ai/quant-core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic quantitative finance formulas, technical indicators, risk metrics, and market simulators for QuantAI",
  "author": "yuva.devlab@gmail.com",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@quant-ai/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
