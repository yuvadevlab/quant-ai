{
  "name": "@quant-ai/prompts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Centralized, type-safe prompt constants, quantitative specialist personas, and dynamic prompt builders for QuantAI",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@quant-ai/shared-types": "workspace:*",
    "@yuva-devlab/agent-core": "^0.2.4",
    "@yuva-devlab/logger": "^1.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
